# Copy this file to .env and fill in the two REQUIRED values.
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env

# --- REQUIRED ---------------------------------------------------------------

# IP address of your Homey Pro (Homey app -> Settings -> General, or your router)
HOMEY_LOCAL_ADDRESS=192.168.1.42

# API key from https://my.homey.app -> Settings -> API Keys (select all scopes).
# Paste the whole key, including both colons.
HOMEY_LOCAL_TOKEN=paste-your-api-key-here

# --- Leave these as they are ------------------------------------------------

# The local Homey API works over plain HTTP on your home network.
HOMEY_USE_HTTPS=false
HOMEY_VERIFY_SSL=false

LOG_LEVEL=INFO

# Set both to true to try it with a fake demo house (no Homey needed).
OFFLINE_MODE=false
DEMO_MODE=false
